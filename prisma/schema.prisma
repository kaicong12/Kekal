// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider               = "prisma-client-js"
  output                 = "../app/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "js"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

model AuthorizedReceiptEmail {
  email String @id

  @@map("authorizedReceiptEmails")
}

model Motorcycle {
  id             String  @id @default(cuid())
  brand          String
  name           String
  model          String
  year           String
  price          Decimal
  engine         String
  engineCapacity Int
  gear           String
  color          String
  tags           String?
  description    String?
  specification  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     MotorcycleImage[]
  promotions Promotion[]

  @@unique([brand, name, year])
  @@map("motorcycles")
}

// NONE covers non-price offers (free helmet, free service): they still run a
// countdown, they just leave the price alone.
enum DiscountType {
  NONE
  FIXED_AMOUNT // discountValue = ringgit off the base price
  PERCENTAGE // discountValue = percent off, 0-100
  OVERRIDE_PRICE // discountValue = the final price, ignore the base
}

// Ordered least- to most-specific; the resolver relies on that ordering to pick
// a single winner per bike.
enum PromotionScope {
  ALL // every bike in the catalogue
  TAG // Motorcycle.tags contains value
  BRAND // Motorcycle.brand equals value
  MODEL // Motorcycle.model equals value
  MOTORCYCLE // Motorcycle.id equals value
}

model Promotion {
  id              String   @id @default(cuid())
  title           String
  subtitle        String?
  description     String?
  imageUrl        String?
  ctaText         String   @default("Claim this deal")
  whatsappMessage String?
  isFeatured      Boolean  @default(false)
  isActive        Boolean  @default(true)
  startDate       DateTime
  endDate         DateTime
  displayOrder    Int      @default(0)

  discountType  DiscountType @default(NONE)
  discountValue Decimal?

  // Presentational only: fronts the promo card when the promotion has no image
  // of its own. Not targeting — see `targets`.
  motorcycleId String?
  motorcycle   Motorcycle? @relation(fields: [motorcycleId], references: [id], onDelete: SetNull)

  targets PromotionTarget[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startDate, endDate])
  @@map("promotions")
}

// A promotion applies to a bike if any non-exclusion row matches and no
// exclusion row does. A new targeting dimension later is one enum value, not a
// migration of existing data.
model PromotionTarget {
  id          String         @id @default(cuid())
  scope       PromotionScope
  value       String? // null only for ALL
  isExclusion Boolean        @default(false)

  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, scope, value])
  @@index([scope, value])
  @@map("promotionTargets")
}

model ProductSyncFile {
  id          String   @id @default(cuid())
  filePath    String   @unique
  isProcessed Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@map("productSyncFiles")
}

model MotorcycleImage {
  id           String @id @default(cuid())
  url          String
  displayOrder Int    @default(0)

  motorcycleId String
  motorcycle   Motorcycle @relation(fields: [motorcycleId], references: [id], onDelete: Cascade)

  @@map("motorcycleImages")
}
